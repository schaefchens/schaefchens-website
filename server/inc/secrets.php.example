<?php
/**
 * Copy to secrets.php and fill in. Never commit the copy — it is gitignored,
 * and scripts/deploy.sh refuses to run without it.
 *
 * secrets.php is uploaded to /inc, which .htaccess denies over HTTP. PHP still
 * reads it from disk: Apache's authz rules govern requests, not the filesystem.
 */

declare(strict_types=1);

/** Signs the gate cookie.  php -r 'echo bin2hex(random_bytes(32)),"\n";' */
const GATE_SECRET = 'CHANGE-ME';

/**
 * Unlocks /assets and /media at the Apache level. Hex only — it is substituted
 * into a RewriteCond regex by the deploy script, so it must not contain
 * anything a regex would treat as special.
 * php -r 'echo bin2hex(random_bytes(16)),"\n";'
 */
const GATE_ASSET_KEY = 'CHANGE-ME';

/**
 * Accepted answers to "Wer ist der Herr?".
 *
 * Compared whole-word, after lowercasing and folding accents, against every
 * word of the answer — so "Der Herr ist Jesus Christus" passes on `jesus`,
 * while "Antichrist" and "christlich" match nothing. Edit this list on the
 * server and it takes effect immediately; no rebuild, no redeploy.
 *
 * Note `christ`: in German that means "a Christian" rather than the name, so
 * strictly it is only right in English. It is accepted anyway — turning away a
 * German speaker who typed it meaning Christus would be the worse mistake.
 */
const GATE_ANSWERS = [
    'jesus', 'jesu', 'jesuschristus', 'jesuschrist',
    'christus', 'christ', 'christi', 'christos',
    'yeshua', 'jeshua', 'yahshua',
    'messias', 'messiah', 'mashiach',
    'immanuel', 'emmanuel',
];

/**
 * Where contact-form messages are emailed.
 *
 * An empty string means log-to-disk only, which is the current setting: every
 * message still lands in lib/state/messages.jsonl. Put an address here — e.g.
 * 'app.support@schaefchens.de' — and sending switches on, with no other change.
 */
const CONTACT_MAIL = '';

/** Envelope sender for that mail. Must be a mailbox on this domain or the host drops it. */
const CONTACT_FROM = 'noreply@schaefchens.de';
