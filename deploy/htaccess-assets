# Vite's content-hashed output: any change to a file produces a new filename, so
# an old name can never serve wrong content and these are safe to cache forever.
#
# The cookie check that guards this directory lives in the root .htaccess — it
# has to, because it must run before Apache resolves the file.

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>

# Compression is inherited from the root .htaccess and needs nothing here.
