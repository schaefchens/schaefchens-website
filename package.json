{
  "name": "schaefchens-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:tokens && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "shots": "node scripts/shots.mjs",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry": "bash scripts/deploy.sh --dry-run",
    "deploy:verify": "bash scripts/deploy.sh --verify-only",
    "check:tokens": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "puppeteer-core": "^25.10.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
